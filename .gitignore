# Raw data is fetched on demand via scripts/fetch_raw_data.py (large files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models and generated results are reproducible via scripts/run_pipeline.py,
# but are committed anyway so the deployed Streamlit app has data to show
# without needing to run the pipeline on the hosting platform.

__pycache__/
*.pyc
.ipynb_checkpoints/
.streamlit/
